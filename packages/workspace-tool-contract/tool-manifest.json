  {
    "name": "workspace_set_mail_read_state",
    "title": "Change mail read state",
    "description": "Propose marking selected Gmail threads read or unread. This is a write and always requires user approval.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "account": {
          "type": "string",
          "description": "Friendly account label or connected email address.",
          "maxLength": 160
        },
        "messageIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string"
          }
        },
        "state": {
          "type": "string",
          "description": "Desired state.",
          "maxLength": 1000,
          "enum": [
            "read",
            "unread"
          ]
        },
        "scope": {
          "type": "string",
          "description": "Apply to the thread by default.",
          "maxLength": 1000,
          "enum": [
            "thread",
            "message"
          ]
        }
      },
      "required": [
        "account",
        "messageIds",
        "state"
      ]
    },
    "readOnly": false,
    "untrustedContent": false,
    "destructive": false
  },
  {
    "name": "workspace_find_tasks",
    "title": "Find tasks",
    "description": "Find Google Tasks by list, text, status, date, or virtual tag.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "account": {
          "type": "string",
          "description": "Friendly account label or connected email address.",
          "maxLength": 160
        },
        "query": {
          "type": "string",
          "description": "Optional task text or tag.",
          "maxLength": 1000
        },
        "list": {
          "type": "string",
          "description": "Optional friendly task-list name.",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "description": "Task status.",
          "maxLength": 1000,
          "enum": [
            "needsAction",
            "completed",
            "all"
          ]
        }
      }
    },
    "readOnly": true,
    "untrustedContent": true,
    "destructive": false
  },
  {
    "name": "workspace_create_task",
    "title": "Create task",
    "description": "Propose a Google Task with a concise title, short notes, list, due date, and tags. Requires user approval before creation.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "account": {
          "type": "string",
          "description": "Friendly account label or connected email address.",
          "maxLength": 160
        },
        "title": {
          "type": "string",
          "description": "Short task title.",
          "maxLength": 200
        },
        "notes": {
          "type": "string",
          "description": "Short supporting details; do not paste long documents.",
          "maxLength": 2000
        },
        "list": {
          "type": "string",
          "description": "Task-list name such as My Tasks or Backlog.",
          "maxLength": 80
        },
        "due": {
          "type": "string",
          "description": "Due date in YYYY-MM-DD format.",
          "maxLength": 64
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 40
          },
          "maxItems": 10
        }
      },
      "required": [
        "title"
      ]
    },
    "readOnly": false,
    "untrustedContent": false,
    "destructive": false
  },
